// Schema gerado a partir de docs/DATA_MODEL.md (fonte da verdade do modelo).
// Nomes de domínio em português (camelCase), mapeados para colunas/tabelas
// em snake_case via @map/@@map, conforme convenção do CLAUDE.md.
//
// Desvio do SQL de referência: campos INTERVAL do documento (duração de
// treino, tempo total da semana, meta de tempo etc.) viraram Int em
// segundos (sufixo "Segundos"/"_segundos") — decisão tomada com o dono do
// projeto porque o Prisma não tem tipo nativo para INTERVAL do Postgres.
//
// Semana.kmPlanejadoTotal/tempoPlanejadoTotalSegundos propositalmente NÃO
// existem como colunas — são calculados a partir de TreinoPrevisto (ver
// nota de implementação em docs/DATA_MODEL.md).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// Ciclo de preparação (ex: "Meia Maratona - Set/2026")
// A prova alvo NÃO é armazenada aqui — é a Prova (tipo='alvo') vinculada
// via `provas`, fonte única de verdade (evita duplicidade/desync com as
// telas de Provas — ver docs/DATA_MODEL.md).
model Ciclo {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome       String
  dataInicio DateTime @map("data_inicio") @db.Date
  dataFim    DateTime @map("data_fim") @db.Date
  status     String   @default("ativo") // ativo | concluido | cancelado
  criadoEm   DateTime @default(now()) @map("criado_em") @db.Timestamptz

  semanas     Semana[]
  provas      Prova[]
  importacoes Importacao[]

  @@map("ciclo")
}

// Um upload de planilha (RF05). Cada treino_previsto criado por ele fica
// vinculado aqui — permite listar "últimas planilhas importadas" e
// excluir a importação inteira de uma vez (sem apagar a semana em si,
// que pode ser reaproveitada por outras importações — ver ImportService).
model Importacao {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cicloId        String   @map("ciclo_id") @db.Uuid
  nomeArquivo    String?  @map("nome_arquivo")
  semanasCriadas Int      @map("semanas_criadas")
  treinosCriados Int      @map("treinos_criados")
  linhasComErro  Int      @default(0) @map("linhas_com_erro")
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz

  ciclo   Ciclo            @relation(fields: [cicloId], references: [id], onDelete: Cascade)
  treinos TreinoPrevisto[]

  @@map("importacao")
}

// Semana dentro de um ciclo
model Semana {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cicloId      String   @map("ciclo_id") @db.Uuid
  numeroSemana Int      @map("numero_semana")
  dataInicio   DateTime @map("data_inicio") @db.Date
  dataFim      DateTime @map("data_fim") @db.Date
  fase         String? // "1. Base (Adaptação)", "2. Específica 21k"...
  rotinaExtra  String?  @map("rotina_extra") // "2x 15min Fortalecimento"

  ciclo            Ciclo            @relation(fields: [cicloId], references: [id], onDelete: Cascade)
  treinosPrevistos TreinoPrevisto[]

  @@map("semana")
}

// Treino previsto. Quantidade por semana é livre (RF06): cada linha tem sua
// própria data/dia_semana, não há colunas fixas por dia.
model TreinoPrevisto {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  semanaId            String   @map("semana_id") @db.Uuid
  diaSemana           String   @map("dia_semana")
  data                DateTime @db.Date
  tipo                String? // rodagem | qualidade | longo | descanso
  descricao           String
  distanciaAlvoKm     Decimal? @map("distancia_alvo_km") @db.Decimal
  duracaoAlvoSegundos Int?     @map("duracao_alvo_segundos")
  paceAlvoMin         String?  @map("pace_alvo_min") // "4:15"
  paceAlvoMax         String?  @map("pace_alvo_max") // "4:20"
  status              String   @default("pendente") // pendente | realizado | nao_realizado | parcial
  motivoNaoRealizado  String?  @map("motivo_nao_realizado")
  importacaoId        String?  @map("importacao_id") @db.Uuid // NULL se criado manualmente, não por CSV

  semana     Semana                    @relation(fields: [semanaId], references: [id], onDelete: Cascade)
  importacao Importacao?               @relation(fields: [importacaoId], references: [id], onDelete: Cascade)
  intervalos TreinoPrevistoIntervalo[]
  realizados TreinoRealizado[]

  @@index([data])
  @@map("treino_previsto")
}

// Estrutura do treino previsto quando é intervalado ("tiro").
// Alimenta o gráfico previsto x realizado por repetição (RF22).
model TreinoPrevistoIntervalo {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  treinoPrevistoId    String   @map("treino_previsto_id") @db.Uuid
  ordem               Int
  tipo                String // aquecimento | tiro | recuperacao | desaquecimento
  repeticaoNumero     Int?     @map("repeticao_numero") // número do tiro; NULL para aquecimento/desaquecimento
  distanciaAlvoKm     Decimal? @map("distancia_alvo_km") @db.Decimal
  duracaoAlvoSegundos Int?     @map("duracao_alvo_segundos")
  paceAlvoMin         String?  @map("pace_alvo_min")
  paceAlvoMax         String?  @map("pace_alvo_max")

  treinoPrevisto TreinoPrevisto @relation(fields: [treinoPrevistoId], references: [id], onDelete: Cascade)

  @@map("treino_previsto_intervalo")
}

// Treino realizado (Garmin ou manual)
model TreinoRealizado {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  treinoPrevistoId String?  @map("treino_previsto_id") @db.Uuid // NULL se treino avulso
  garminActivityId String?  @unique @map("garmin_activity_id") // NULL se manual; garante idempotência (RF14)
  fonte            String   @default("garmin") // garmin | manual
  data             DateTime @db.Date
  distanciaKm      Decimal? @map("distancia_km") @db.Decimal
  duracaoSegundos  Int?     @map("duracao_segundos")
  paceMedio        String?  @map("pace_medio")
  fcMedia          Int?     @map("fc_media")
  fcMax            Int?     @map("fc_max")
  elevacaoM        Decimal? @map("elevacao_m") @db.Decimal
  // Feedback estruturado (RF18)
  rpe              Int? // percepção de esforço, 1-10
  sensacoes        String[] // tags: bem_encaixado | cansado | dor | animado | clima_ruim | teve_que_parar | sub_performou | superou_expectativa
  feedbackTexto    String?  @map("feedback_texto") // relato livre
  observacoes      String? // observações técnicas (distinto do feedback subjetivo)
  criadoEm         DateTime @default(now()) @map("criado_em") @db.Timestamptz

  treinoPrevisto TreinoPrevisto?            @relation(fields: [treinoPrevistoId], references: [id])
  intervalos     TreinoRealizadoIntervalo[]

  @@index([data])
  @@map("treino_realizado")
}

// Splits do treino realizado, vindos do Garmin (tela "Intervals" do app Garmin)
model TreinoRealizadoIntervalo {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  treinoRealizadoId String   @map("treino_realizado_id") @db.Uuid
  ordem             Int
  tipo              String // warmup | run | recovery | cooldown (nomenclatura do Garmin)
  repeticaoNumero   Int?     @map("repeticao_numero") // casa com treinoPrevistoIntervalo.repeticaoNumero
  tempoSegundos     Int?     @map("tempo_segundos")
  distanciaKm       Decimal? @map("distancia_km") @db.Decimal
  paceMedio         String?  @map("pace_medio")
  fcMedia           Int?     @map("fc_media")

  treinoRealizado TreinoRealizado @relation(fields: [treinoRealizadoId], references: [id], onDelete: Cascade)

  @@map("treino_realizado_intervalo")
}

// Provas dentro de um ciclo: uma alvo + N secundárias (RF02)
model Prova {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cicloId                String?  @map("ciclo_id") @db.Uuid
  tipo                   String   @default("alvo") // alvo | secundaria
  nome                   String
  data                   DateTime @db.Date
  distanciaKm            Decimal? @map("distancia_km") @db.Decimal
  metaTempoSegundos      Int?     @map("meta_tempo_segundos")
  resultadoTempoSegundos Int?     @map("resultado_tempo_segundos")
  resultadoPace          String?  @map("resultado_pace")
  concluida              Boolean  @default(false)

  ciclo Ciclo? @relation(fields: [cicloId], references: [id])

  @@map("prova")
}
