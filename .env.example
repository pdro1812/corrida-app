# ── Backend ───────────────────────────────────────────────
# Copiar as variáveis abaixo para backend/.env com valores reais

DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco
PORT=3001

# Autenticação simples (single-user) — gerar um token longo e aleatório
API_KEY=

# Credenciais do Garmin Connect (login não-oficial, ver docs/ARCHITECTURE.md §3)
# Se a senha tiver "#", espaço ou aspas, coloque-a entre aspas duplas
# (ex: GARMIN_PASSWORD="minha#senha") — sem aspas, o dotenv corta tudo
# a partir do "#" por interpretar como início de comentário.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Expressão cron da sincronização automática (padrão: 7h da manhã)
GARMIN_SYNC_CRON=0 7 * * *

# ── App (Expo) ────────────────────────────────────────────
# Não são segredos, mas ficam configuráveis por ambiente (dev/prod)

EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_API_KEY=
